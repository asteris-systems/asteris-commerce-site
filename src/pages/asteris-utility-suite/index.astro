---
/**
 * /asteris-utility-suite/ — Overview (section root).
 * Migrated from asteriscommerce.com/asteris-utility-suite index.astro, June 2026, as part of the
 * "Asteris Utility Suite" / "Asteris Utility Suite" → "Asteris Utility Suite" rename.
 * Canonical URL: https://asteriscommerce.com/asteris-utility-suite
 */
import UtilitySuiteLayout from '../../layouts/UtilitySuiteLayout.astro';

// Canonical 13 modules (Code Snippets removed in v1.0.2). Each "replaces"
// claim has passed the Module Quality Protocol (Tier 1 + Tier 2 gap analysis).
const modules = [
  { name: 'Security + Login + 2FA',     replaces: 'Wordfence Premium ($119)' },
  { name: 'SEO + AI Suite',             replaces: 'Yoast Premium + AI add-on ($228)' },
  { name: 'Backups + Migration',        replaces: 'UpdraftPlus Premium ($70)' },
  { name: 'SMTP + Email Logs',          replaces: 'WP Mail SMTP Pro ($49)' },
  { name: 'Performance',                replaces: 'NitroPack ($25/mo)' },
  { name: 'Image Optimisation',         replaces: 'ShortPixel ($99)' },
  { name: 'Accessibility',              replaces: 'accessiBe ($490)' },
  { name: 'Forms',                      replaces: 'WPForms Pro ($199)' },
  { name: 'Activity Log + Site Health', replaces: 'WP Activity Log Premium ($99)' },
  { name: 'Analytics + Pixels',         replaces: 'PixelYourSite Pro ($99)' },
  { name: 'Asteris Links',              replaces: 'Pretty Links Pro ($99)' },
  { name: 'Asteris Insights',           replaces: 'MonsterInsights Pro ($199)' },
  { name: 'Duplicate Post',             replaces: 'Yoast Duplicate Post' },
];

// Tier pricing (one standard price for everyone):
// Starter $149 (1 site) · Pro $349 (3 sites) · Agency $549 (10 sites)
---

<UtilitySuiteLayout
  title="Asteris Utility Suite — The last WordPress plugin you install"
  description="13 modules in one plugin. Security, SEO + AI, Backups, SMTP, Performance, Image Optimisation, Accessibility, Forms, Activity Log, Analytics — replaces Wordfence, Yoast, UpdraftPlus, WP Mail SMTP and a dozen others. One plugin, one admin, one update button, one licence."
>
  <!-- Hero -->
  <section class="hero">
    <div class="eyebrow">★ 13 modules · one plugin · one standard price</div>
    <h1>
      The last WordPress<br />
      <span class="accent">plugin</span> you install.
    </h1>
    <p class="lead">
      <strong>13 modules in one plugin.</strong>
      Security, SEO + AI, Backups, SMTP, Performance — done. Replaces Wordfence, Yoast, UpdraftPlus, WP Mail SMTP and the rest of the stack you're already paying for.
    </p>
    <div class="hero-actions">
      <a href="/asteris-utility-suite/pricing/" class="btn btn-pop btn-large">Get Asteris Starter →</a>
      <a href="#vs" class="btn btn-outline btn-large">See what it replaces →</a>
    </div>
    <p class="no-cc">No credit card to demo · 14-day money-back guarantee · One-click migrations from Wordfence / Yoast / UpdraftPlus / WP Mail SMTP</p>
  </section>

  <!-- Mission strip (locked brand-wide tagline) -->
  <section class="mission-strip" aria-label="Asteris mission">
    <div class="mission-strip__inner">
      <p class="mission-strip__tagline">
        <span>More inclusions.</span>
        <span>Less cost.</span>
        <span class="mission-strip__accent">Australian-built.</span>
      </p>
      <p class="mission-strip__sub">
        Replaces ~$1,400+/yr of Wordfence + Yoast Premium + UpdraftPlus + WPForms + WP Rocket + Imagify + others — for $149–$549/yr.
      </p>
    </div>
  </section>

  <!-- VS comparison -->
  <section id="vs" class="vs-section">
    <div class="vs-inner">
      <div class="vs-eyebrow">13 modules. One plugin. Zero plugin sprawl.</div>
      <h2>You're already paying for <span class="vs-accent">most</span> of this.<br />Probably twice. Maybe three times.</h2>
      <p class="vs-sub">One update button. One vendor inbox. One licence to manage. Built on PHP 8.1+, modern WordPress 6.4+.</p>
      <div class="vs-grid">
        <div class="vs-card bad">
          <h3>Today: 10+ plugins</h3>
          <div class="subhead">Average WordPress site running security + SEO + backups + SMTP + performance + image + forms…</div>
          <div class="big">$1,400+<span class="big-suffix"> /year</span></div>
          <ul class="vs-list">
            <li>10+ update buttons every Tuesday</li>
            <li>10+ admin pages with different patterns</li>
            <li>10+ vendors to chase for support</li>
            <li>Compatibility roulette every WP update</li>
            <li>Bloat from disabled-but-loaded code</li>
          </ul>
        </div>
        <div class="vs-card good">
          <h3>Tomorrow: Asteris Utility Suite</h3>
          <div class="subhead">One plugin. Activate the modules you need. Disabled = zero code loaded.</div>
          <div class="big"><span class="big-prefix">from </span>$149<span class="big-suffix"> /yr</span></div>
          <ul class="vs-list">
            <li>One update button. One vendor. One bill.</li>
            <li>One unified admin — same patterns across modules</li>
            <li>AI Suite writes SEO meta + form responses + content briefs</li>
            <li>Built to a documented Module Quality Protocol</li>
            <li>One-click migration adapters from the incumbents</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Modules wall -->
  <section class="modules">
    <div class="modules-head">
      <h2>13 modules.<br />Pick the ones<br /><span class="accent">you need.</span></h2>
      <p>Every module is independently toggleable. Disabled modules load zero PHP, zero JS, zero CSS. Performance stays tight as you scale.</p>
    </div>
    <div class="mod-grid">
      {modules.map(m => (
        <a href="/asteris-utility-suite/modules/" class="mod-box">
          <div class="name">{m.name}</div>
          <div class="replaces">replaces {m.replaces}</div>
        </a>
      ))}
    </div>
  </section>

  <!-- Why Asteris — 6 differentiator cards -->
  <section class="why">
    <div class="why-inner">
      <div class="why-head">
        <h2>
          Why one plugin beats <span class="accent">thirteen.</span><br />
          The receipts.
        </h2>
        <p class="why-sub">
          Specific, measurable things you get from a single consolidated plugin built to one architecture — versus what happens when you stack a dozen vendors who don't know about each other.
        </p>
      </div>
      <div class="why-grid">

        <div class="why-card">
          <div class="why-icon" aria-hidden="true">🪶</div>
          <h3>Less bloat — by design.</h3>
          <p>Modules toggle independently. <strong>Disabled modules load zero PHP, zero JS, zero CSS.</strong> Not "lazy loaded later" — never registered in the first place. Your page weight tracks the modules you actually use.</p>
        </div>

        <div class="why-card">
          <div class="why-icon" aria-hidden="true">⚡</div>
          <h3>Faster than the stack it replaces.</h3>
          <p>One bootstrap, one autoload chain, one settings registration pass. Roughly <strong>~70% fewer <code>file_includes</code></strong> than the multi-plugin stack it consolidates — and that's before module-level performance gains kick in.</p>
        </div>

        <div class="why-card">
          <div class="why-icon" aria-hidden="true">📦</div>
          <h3>Smaller footprint.</h3>
          <p>The Asteris Utility Suite is <strong>~3.3 MB on disk</strong> for all 13 modules. The Yoast Premium + Wordfence + UpdraftPlus + WP Rocket + Smush + WPForms + WP Mail SMTP stack runs <strong>~50 MB+</strong> combined. Backups, updates, and migrations move faster too.</p>
        </div>

        <div class="why-card">
          <div class="why-icon" aria-hidden="true">🔘</div>
          <h3>One update button.</h3>
          <p>Not 11 update notifications scattered across <strong>Plugins → Updates</strong> every Tuesday. One plugin, one update. We test the whole bundle as a unit before shipping.</p>
        </div>

        <div class="why-card">
          <div class="why-icon" aria-hidden="true">📬</div>
          <h3>One vendor, one inbox.</h3>
          <p>Not chasing Yoast for SEO, Wordfence for security, UpdraftPlus for backups, WP Mail SMTP for email, MonsterInsights for analytics — each with their own ticket system, SLAs, and account portal. <strong>One support relationship for the whole stack.</strong></p>
        </div>

        <div class="why-card">
          <div class="why-icon" aria-hidden="true">💳</div>
          <h3>One licence, one bill.</h3>
          <p>Asteris Starter is <strong>$149/yr for all 13 modules</strong>. Buying the equivalent separately (Yoast Premium $129 + Wordfence $119 + WPForms Pro $199 + WP Rocket $59 + Smush Pro $90 + UpdraftPlus $70 + WP Mail SMTP Pro $49 + WP Activity Log $99 + MonsterInsights $199 + accessibility scanner ~$120) runs <strong>~$1,430/yr</strong>.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Free funnel strip -->
  <section class="free-strip">
    <div class="free-inner">
      <div>
        <div class="free-eyebrow">★ Start free</div>
        <h3>Not ready to commit? <span class="accent">Start with the free edition.</span></h3>
        <p>
          Real modules, free forever on WordPress.org under the slug <code>asteris-utility-suite</code>. Lite versions of <strong>Image Optimisation</strong>, <strong>Analytics + Pixels</strong>, <strong>Activity Log</strong>, <strong>SMTP</strong>, and the <strong>Accessibility scanner</strong>. No credit card, no upsell wall, no time limit. Upgrade when you outgrow them.
        </p>
      </div>
      <div class="free-actions">
        <a href="/asteris-utility-suite/pricing/" class="btn btn-large">See what's free →</a>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="lifetime-section">
    <div class="lifetime-inner">
      <div class="eyebrow lifetime-eyebrow">★ One standard price · every module on every paid tier</div>
      <h2 class="lifetime-h2">
        One plugin.<br />
        <span class="lifetime-accent">One standard price.</span>
      </h2>
      <p class="lifetime-lead">
        Pay <strong>$149/yr</strong> for Asteris Starter, <strong>$349/yr</strong> for Pro (3 sites), or <strong>$549/yr</strong> for Agency (10 sites). <strong class="orange">Every paid tier unlocks all 13 modules</strong> — the only difference is how many sites you can install on.
      </p>
      <p class="lifetime-disclosure">
        <strong>The Asteris Utility Suite is in active development. As an early customer, you're shaping it.</strong> Your bug reports + feedback are part of the deal — and so are all future updates while your subscription stays active.
      </p>

      <div class="lifetime-stats">
        <div class="lstat">
          <div class="lstat-label">Asteris Starter (1 site)</div>
          <div class="lstat-value">$149<span class="lstat-suffix">/yr</span></div>
          <div class="lstat-note">All 13 modules · 1 site</div>
        </div>
        <div class="lstat lstat-pop">
          <div class="lstat-label">Asteris Pro (3 sites)</div>
          <div class="lstat-value lstat-orange">$349<span class="lstat-suffix">/yr</span></div>
          <div class="lstat-note">All 13 modules · 3 sites</div>
        </div>
        <div class="lstat">
          <div class="lstat-label">Asteris Agency (10 sites)</div>
          <div class="lstat-value">$549<span class="lstat-suffix">/yr</span></div>
          <div class="lstat-note">All 13 modules · 10 sites</div>
        </div>
      </div>

      <ul class="lifetime-perks">
        <li>★ <strong>All 13 modules</strong> + every future module shipped during your subscription</li>
        <li>★ <strong>One-click importers</strong> from Yoast / RankMath / AIOSEO / SEOPress · run-alongside compatibility with Wordfence, UpdraftPlus, WP Mail SMTP</li>
        <li>★ <strong>Priority support</strong> · 1 business day for Pro / Agency, 2-3 business days for Starter</li>
        <li>★ <strong>Direct say on the v1.x roadmap</strong> · we read every bug report and feature request</li>
        <li>★ <strong>Same shared SEO + AI library</strong> as Asteris for WooCommerce — zero data divergence if you run both</li>
      </ul>

      <div class="lifetime-actions">
        <a href="/asteris-utility-suite/pricing/" class="btn btn-pop btn-large lifetime-btn">★ See full pricing</a>
        <span class="lifetime-note">14-day refund · processed via Stripe · instant licence delivery</span>
      </div>
    </div>
  </section>

  <!-- Sister product -->
  <section class="sister-strip">
    <div class="container">
      <h2>Run a WooCommerce store too?</h2>
      <p>Asteris for WooCommerce is the sister product — same architecture, same engineering bar, 20 modules for WooCommerce stores. Built by the same small team. Shares the SEO + AI Suite, Analytics, Links, AI library, and Activity Log + Site Health modules with this plugin so customers running both get zero data divergence.</p>
      <a href="https://asterisforwoocommerce.com" class="btn btn-large btn-outline" target="_blank" rel="noopener">Visit Asteris for WooCommerce →</a>
    </div>
  </section>

  <!-- Story note -->
  <section class="founder-note">
    <h2>Why we built this</h2>
    <p>We run WordPress sites — our own blogs, business sites, project sites. We got sick of paying $1,400+/yr across Wordfence, Yoast, UpdraftPlus, WP Mail SMTP, WP Rocket, Smush, WPForms, MonsterInsights, WP Activity Log, PixelYourSite, Pretty Links and an accessibility tool. A dozen vendors. A dozen update cycles. A dozen JavaScript bundles loading on the WP Admin dashboard.</p>
    <p>We wanted one plugin. So our small team built it. The Asteris Utility Suite is that plugin — 13 modules at v1.0, one settings panel, one update cycle, one inbox to email when something breaks. Built in Sydney through My Cosmic Message Pty Ltd t/a Asteris Commerce (ACN 652 358 159).</p>
    <p class="sig">— The Asteris team</p>
  </section>
</UtilitySuiteLayout>

<style>
  /* Hero */
  .hero { max-width: 1100px; margin: 0 auto; padding: 80px 36px 60px; }
  .hero .eyebrow {
    display: inline-block; background: var(--c-orange); color: var(--c-white);
    padding: 6px 14px; font-size: 12px; font-weight: 700; letter-spacing: 0.8px;
    text-transform: uppercase; border-radius: var(--r-sm); transform: rotate(-2deg); margin-bottom: 32px;
  }
  .hero h1 { font-size: 88px; line-height: 0.95; letter-spacing: -3.5px; font-weight: 900; margin-bottom: 28px; overflow-wrap: break-word; }
  .hero .accent { display: inline-block; background: var(--c-yellow); color: var(--c-black); padding: 0 12px; transform: skew(-3deg); }
  .hero p.lead { font-size: 22px; color: #444; max-width: 680px; margin-bottom: 36px; line-height: 1.4; }
  .hero p.lead strong { color: var(--c-black); }
  .hero-actions { display: flex; gap: 14px; align-items: center; margin-bottom: 24px; flex-wrap: wrap; }
  .no-cc { color: #666; font-size: 13px; }
  @media (max-width: 700px) {
    .hero { padding: 48px 24px 36px; }
    .hero h1 { font-size: 40px; letter-spacing: -1.2px; }
    .hero p.lead { font-size: 18px; }
  }

  /* Mission strip */
  .mission-strip { background: linear-gradient(135deg, #0a0a0a 0%, #141622 100%); color: #fff; padding: 48px 36px; border-top: 1px solid #1f2937; border-bottom: 1px solid #1f2937; }
  .mission-strip__inner { max-width: 1100px; margin: 0 auto; text-align: center; }
  .mission-strip__tagline { font-size: clamp(24px, 3.5vw, 38px); font-weight: 800; line-height: 1.15; letter-spacing: -0.5px; margin: 0 0 14px; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 18px; }
  .mission-strip__accent { color: #3D5AFE; text-shadow: 0 0 24px rgba(61, 90, 254, 0.35); }
  .mission-strip__sub { font-size: 14px; color: #cbd5e1; max-width: 760px; margin: 0 auto; line-height: 1.5; }

  /* VS */
  .vs-section { background: var(--c-black); color: var(--c-white); padding: 96px 36px; }
  .vs-inner { max-width: 1100px; margin: 0 auto; }
  .vs-eyebrow { display: inline-block; background: var(--c-orange); color: var(--c-white); padding: 6px 14px; font-size: 12px; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; border-radius: var(--r-sm); margin-bottom: 16px; }
  .vs-section h2 { font-size: 48px; margin-bottom: 20px; max-width: 1000px; color: var(--c-white); }
  .vs-accent { background: var(--c-yellow); color: var(--c-black) !important; padding: 0 6px; }
  .vs-sub { font-size: 17px; margin-bottom: 48px; max-width: 720px; color: #ccc; }
  .vs-sub a { color: var(--c-orange); text-decoration: underline; }
  .vs-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  @media (max-width: 768px) { .vs-grid { grid-template-columns: 1fr; } .vs-section h2 { font-size: 32px; } }
  .vs-card { padding: 28px; border-radius: var(--r-lg); }
  .vs-card h3 { font-size: 22px; margin-bottom: 6px; }
  .vs-card .subhead { font-size: 13px; color: #888; margin-bottom: 16px; }
  .vs-card .big { font-size: 56px; font-weight: 900; letter-spacing: -2px; margin-bottom: 18px; }
  .vs-card .big-prefix, .vs-card .big-suffix { font-size: 15px; font-weight: 500; color: #888; letter-spacing: 0; }
  .vs-card.bad { background: #1c1c1c; border: 2px solid #333; }
  .vs-card.bad h3, .vs-card.bad .big { color: #ff8c8c; }
  .vs-card.good { background: var(--c-white); color: var(--c-black); border: 2px solid var(--c-orange); }
  .vs-card.good h3 { color: var(--c-black); }
  .vs-card.good .big { color: var(--c-orange); }
  .vs-card.good .subhead { color: #666; }
  .vs-card.good .big-prefix, .vs-card.good .big-suffix { color: #666; }
  .vs-list { list-style: none; padding: 0; margin: 0; font-size: 14px; line-height: 1.7; }
  .vs-list li { padding: 4px 0 4px 22px; position: relative; }
  .vs-card.bad .vs-list li::before { content: '✕'; position: absolute; left: 0; color: #ff8c8c; }
  .vs-card.good .vs-list li::before { content: '✓'; position: absolute; left: 0; color: var(--c-orange); font-weight: 700; }

  /* Modules wall */
  .modules { padding: 80px 36px; max-width: 1200px; margin: 0 auto; }
  .modules-head { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: end; margin-bottom: 48px; }
  .modules-head h2 { font-size: 56px; line-height: 0.95; letter-spacing: -2px; }
  .modules-head h2 .accent { background: var(--c-yellow); color: var(--c-black); padding: 0 8px; transform: skew(-3deg); display: inline-block; }
  .modules-head p { font-size: 16px; color: #555; max-width: 460px; }
  @media (max-width: 768px) { .modules-head { grid-template-columns: 1fr; } .modules-head h2 { font-size: 36px; } }
  .mod-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
  .mod-box { background: var(--c-white); border: 2px solid var(--c-black); border-radius: var(--r-md); padding: 18px; text-decoration: none; color: var(--c-black); transition: transform 0.1s, box-shadow 0.1s; }
  .mod-box:hover { transform: translate(-2px, -2px); box-shadow: var(--pop-shadow); }
  .mod-box .name { font-weight: 800; font-size: 15px; margin-bottom: 4px; }
  .mod-box .replaces { color: var(--c-orange); font-size: 12px; }

  /* Why Asteris */
  .why { background: #f7f7f9; padding: 96px 36px; }
  .why-inner { max-width: 1200px; margin: 0 auto; }
  .why-head { max-width: 760px; margin: 0 auto 56px; text-align: center; }
  .why-head h2 { font-size: 52px; line-height: 1.0; letter-spacing: -1.5px; margin: 0 0 18px; }
  .why-head h2 .accent { background: var(--c-yellow); color: var(--c-black); padding: 0 8px; transform: skew(-3deg); display: inline-block; }
  .why-head .why-sub { font-size: 17px; line-height: 1.55; color: #444; max-width: 640px; margin: 0 auto; }
  .why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .why-card { background: var(--c-white); border: 2px solid var(--c-black); border-radius: 12px; padding: 28px 24px; box-shadow: 4px 4px 0 var(--c-black); transition: transform 0.15s ease, box-shadow 0.15s ease; }
  .why-card:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--c-black); }
  .why-icon { font-size: 32px; margin-bottom: 12px; line-height: 1; }
  .why-card h3 { font-size: 18px; font-weight: 800; margin: 0 0 10px; line-height: 1.25; }
  .why-card p { font-size: 14px; line-height: 1.55; color: #333; margin: 0; }
  .why-card code { background: #f0f0f3; padding: 1px 5px; border-radius: 3px; font-size: 13px; }
  @media (max-width: 900px) { .why-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .why-grid { grid-template-columns: 1fr; } .why-head h2 { font-size: 38px; } }

  /* Free strip */
  .free-strip { background: var(--c-yellow); padding: 64px 36px; }
  .free-inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 2fr 1fr; gap: 32px; align-items: center; }
  .free-eyebrow { display: inline-block; background: var(--c-black); color: var(--c-white); padding: 4px 12px; font-size: 12px; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; border-radius: var(--r-sm); margin-bottom: 14px; }
  .free-strip h3 { font-size: 32px; line-height: 1.1; letter-spacing: -1px; margin-bottom: 12px; }
  .free-strip .accent { background: var(--c-orange); color: var(--c-white) !important; padding: 0 8px; transform: skew(-3deg); display: inline-block; }
  .free-strip p { font-size: 15px; color: #333; max-width: 600px; line-height: 1.5; }
  .free-strip code { background: rgba(0,0,0,0.08); padding: 1px 6px; border-radius: 3px; font-size: 13px; }
  .free-actions { text-align: right; }
  @media (max-width: 768px) { .free-inner { grid-template-columns: 1fr; } .free-actions { text-align: left; } }

  /* Pricing */
  .lifetime-section { background: var(--c-black); color: var(--c-white); padding: 96px 36px; border-top: 6px solid var(--c-orange); }
  .lifetime-inner { max-width: 1100px; margin: 0 auto; }
  .lifetime-eyebrow { display: inline-block; background: var(--c-orange); color: var(--c-white); padding: 6px 14px; font-size: 12px; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; border-radius: var(--r-sm); }
  .lifetime-h2 { font-size: 56px; line-height: 1.05; letter-spacing: -2.5px; margin: 16px 0 24px; color: var(--c-white); }
  .lifetime-accent { background: var(--c-yellow); color: var(--c-black); padding: 0 10px; display: inline-block; transform: skew(-3deg); }
  .lifetime-lead { font-size: 18px; color: #bbb; max-width: 820px; line-height: 1.5; margin-bottom: 24px; }
  .lifetime-lead strong { color: var(--c-white); }
  .lifetime-lead strong.orange { color: var(--c-orange); }
  .lifetime-disclosure { background: rgba(61, 90, 254, 0.08); border-left: 3px solid var(--c-orange); padding: 16px 20px; border-radius: var(--r-sm); font-size: 15px; color: #ccc; line-height: 1.5; max-width: 820px; margin-bottom: 36px; }
  .lifetime-disclosure strong { color: var(--c-white); }
  .lifetime-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 36px; }
  .lstat { background: #1a1a1a; border: 2px solid #2a2a2a; padding: 22px; border-radius: var(--r-md); }
  .lstat-pop { border-color: var(--c-orange); }
  .lstat-label { color: var(--c-orange); font-size: 12px; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; margin-bottom: 8px; }
  .lstat-value { font-size: 42px; font-weight: 900; letter-spacing: -2px; line-height: 1; }
  .lstat-orange { color: var(--c-orange); }
