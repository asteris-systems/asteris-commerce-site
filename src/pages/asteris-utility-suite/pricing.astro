---
/**
 * /asteris-utility-suite/pricing/ — pricing + FAQ.
 * Migrated + renamed from asteriscommerce.com/asteris-utility-suite pricing.astro, June 2026.
 * Stripe buy links + customer portal (pay.asteriscommerce.com) preserved as-is.
 */
import UtilitySuiteLayout from '../../layouts/UtilitySuiteLayout.astro';

const tiers = [
  {
    name: 'Free edition',
    sites: 'Unlimited',
    price: '$0',
    cadence: 'forever',
    cta: 'Get it free',
    ctaHref: 'https://wordpress.org/plugins/asteris-utility-suite/',
    bullets: [
      'Lite versions of Image Optimisation, Analytics + Pixels, Activity Log, SMTP, Accessibility scanner',
      'On WordPress.org — no credit card',
      'GPL-2.0+ · unlimited sites · forever',
      'Forum support · 2–3 business day email fallback',
    ],
    style: 'free',
  },
  {
    name: 'Asteris Starter',
    sites: '1 site',
    price: '$149',
    cadence: '/year',
    monthly: '$17/mo',
    cta: 'Get Asteris Starter',
    ctaHref: 'https://buy.stripe.com/00wfZgeQyai3dra5Rz4Vy06',
    ctaHrefMonthly: 'https://buy.stripe.com/9B69AS37Q0Htbj2bbT4Vy07',
    bullets: [
      'All 12 modules',
      '1 production site',
      'All updates · all bug fixes · all security patches',
      '2–3 business day support · 14-day refund',
    ],
    style: 'starter',
  },
  {
    name: 'Asteris Pro',
    sites: '3 sites',
    price: '$349',
    cadence: '/year',
    monthly: '$39/mo',
    cta: 'Get Asteris Pro',
    ctaHref: 'https://buy.stripe.com/cNi6oG9we3TF0Eo6VD4Vy08',
    ctaHrefMonthly: 'https://buy.stripe.com/fZu8wO7o6eyjbj25Rz4Vy09',
    bullets: [
      'All 12 modules',
      '3 production sites',
      'Priority support · 1 business day',
      '14-day refund',
    ],
    featured: true,
    style: 'pro',
  },
  {
    name: 'Asteris Agency',
    sites: '10 sites',
    price: '$549',
    cadence: '/year',
    monthly: '$59/mo',
    cta: 'Get Asteris Agency',
    ctaHref: 'https://buy.stripe.com/00wbJ023M2PB2Mwdk14Vy0a',
    ctaHrefMonthly: 'https://buy.stripe.com/bJefZg8sadufdra7ZH4Vy0b',
    bullets: [
      'All 12 modules',
      '10 production sites',
      'Priority support · 1 business day · Dedicated Slack channel (v1.1)',
      'NO white-label (v1.0)',
    ],
    style: 'agency',
  },
];

const compareRowsAnnual = [
  { label: 'Price', vals: ['$0', '$149/yr', '$349/yr', '$549/yr'] },
  { label: 'Sites', vals: ['∞', '1', '3', '10'] },
  { label: 'Modules', vals: ['5 (lite)', '12 + future', '12 + future', '12 + future'] },
  { label: 'Support', vals: ['Forum', '2–3 days', '1 day', '1 day'] },
  { label: 'Renews', vals: ['—', 'Annually', 'Annually', 'Annually'] },
];

const compareRowsMonthly = [
  { label: 'Monthly price', vals: ['—', '$17/mo', '$39/mo', '$59/mo'] },
  { label: 'Monthly premium vs annual', vals: ['—', '+37%', '+34%', '+29%'] },
  { label: 'Sites', vals: ['—', '1', '3', '10'] },
  { label: 'Modules', vals: ['—', '12 + future', '12 + future', '12 + future'] },
  { label: 'Renews', vals: ['—', 'Monthly', 'Monthly', 'Monthly'] },
  { label: 'Cancel anytime', vals: ['—', '✓', '✓', '✓'] },
];

const faqs = [
  { q: 'Is there a monthly billing option?', a: 'Yes for all paid tiers — Starter $17/mo, Pro $39/mo, Agency $59/mo. Cancel anytime.' },
  { q: 'What happens when my annual licence expires?', a: 'The Asteris Utility Suite continues to work but stops receiving updates and support. Renew to resume.' },
  { q: 'Can I switch tiers?', a: 'Yes. Upgrades are pro-rated. Downgrades take effect at the next renewal. Email support@ to initiate.' },
  { q: 'Can I transfer my licence to a different domain?', a: 'Yes — within the site count for your tier. Email support@ — no fees, no friction.' },
  { q: 'What does the 14-day refund cover?', a: 'Any paid tier, purchased directly from asteriscommerce.com, within 14 days. Processed within 24 hours.' },
  { q: 'Does the free edition require a licence key?', a: 'No. The free Asteris Utility Suite installs from WordPress.org like any other plugin. No account required.' },
  { q: 'Is the Agency tier white-label?', a: 'No (v1.0). Asteris branding remains in the WP admin. Agency is for installs across up to 10 sites, not for reselling.' },
  { q: 'What licence type is the Asteris Utility Suite?', a: 'GPL-2.0+. The plugin code is GPL, consistent with WordPress\'s own licence requirements.' },
  { q: 'Are prices in USD?', a: 'Yes. All prices USD. Stripe handles currency display + tax (EU VAT, UK VAT) at checkout. Australian GST is included in your billing once we cross the AU $75k GST threshold; until then, no GST on AU sales.' },
];
---

<UtilitySuiteLayout
  title="Asteris Utility Suite — Pricing (Free, Starter $149, Pro $349, Agency $549)"
  description="The Asteris Utility Suite: free on WordPress.org. Starter $149/yr, Pro $349/yr, Agency $549/yr. One standard price for everyone."
>
  <section class="pricing-hero">
    <div class="container">
      <div class="eyebrow">★ One standard price for everyone</div>
      <h1>Pricing.<br /><span class="accent">Simple and standard.</span></h1>
      <p class="lead">
        All paid tiers include every one of the 12 modules. <strong>The only thing that varies is how many sites you can install on.</strong> Everyone pays the same standard price — no tiers of customer, no offers to chase.
      </p>
    </div>
  </section>

  <!-- Mission strip -->
  <section class="mission-strip" aria-label="Asteris mission">
    <div class="mission-strip__inner">
      <p class="mission-strip__tagline">
        <span>More inclusions.</span>
        <span>Less cost.</span>
        <span class="mission-strip__accent">Australian-built.</span>
      </p>
      <p class="mission-strip__sub">
        Replaces ~$1,400+/yr of Wordfence + Yoast Premium + UpdraftPlus + WPForms + WP Rocket + Imagify + others — for $149–$549/yr.
      </p>
    </div>
  </section>

  <!-- 4 annual tiers -->
  <section class="tier-grid">
    <div class="container">
      <div class="grid">
        {tiers.map(t => (
          <div class={`tier ${t.style}${t.featured ? ' featured' : ''}`}>
            {t.featured && <div class="pop-tag">MOST POPULAR</div>}
            <h3>{t.name}</h3>
            <div class="sites">{t.sites}</div>
            <div class="price-row">
              <span class="price">{t.price}</span>
              <span class="cadence">{t.cadence}</span>
            </div>
            {t.monthly && <div class="monthly">or <strong>{t.monthly}</strong> · cancel anytime</div>}
            <ul>
              {t.bullets.map(b => <li>{b}</li>)}
            </ul>
            <a
              href={t.ctaHref}
              class={`btn ${t.featured ? 'btn-pop' : ''} btn-large`}
              {...(t.ctaHref?.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
            >{t.cta}</a>
            {t.ctaHrefMonthly && (
              <a
                href={t.ctaHrefMonthly}
                class="btn-monthly-link"
                target="_blank"
                rel="noopener"
              >or subscribe monthly →</a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Active-development disclosure -->
  <section class="lifetime-cta">
    <div class="container">
      <div class="lcard">
        <h2>One price. <span class="laccent">Every module. Every update.</span></h2>
        <p class="llead">
          Subscribe at <strong>$149/yr Starter</strong>, <strong>$349/yr Pro</strong>, or <strong>$549/yr Agency</strong>. Every paid tier unlocks all 12 modules — the only difference is how many sites you can install on.
        </p>
        <p class="ldisclosure">
          <strong>The Asteris Utility Suite is in active development. As an early customer, you're shaping it.</strong> Your bug reports + feedback are part of the deal — and so are all future updates while your subscription stays active.
        </p>
      </div>
    </div>
  </section>

  <!-- Compare table -->
  <section class="compare">
    <div class="container">
      <h2>What's the same. What's different.</h2>
      <p class="csub">Everything across all paid tiers vs what differs by tier.</p>
      <div class="same-grid">
        <ul>
          <li>★ <strong>All 12 modules</strong> on every paid tier (free edition has 5 lite modules)</li>
          <li>★ <strong>All updates + bug fixes + security patches</strong> for the duration of your licence</li>
          <li>★ <strong>14-day refund</strong>, processed within 24 hours via Stripe</li>
          <li>★ Licence key emailed instantly · download from customer portal at <code>pay.asteriscommerce.com</code></li>
          <li>★ Card, Apple Pay / Google Pay, and regional methods accepted (Stripe)</li>
          <li>★ The free edition continues to work alongside any paid tier</li>
        </ul>
      </div>
      <h3 style="margin-top:2.5em;">Annual subscriptions</h3>
      <p class="csub">Bigger upfront commitment, lower effective per-year price. Recommended for stable / production sites.</p>
      <div class="ctable-wrap">
        <table class="ctable">
          <thead>
            <tr>
              <th></th>
              <th>Free</th>
              <th>Starter</th>
              <th class="featured-col">Pro</th>
              <th>Agency</th>
            </tr>
          </thead>
          <tbody>
            {compareRowsAnnual.map(row => (
              <tr>
                <th>{row.label}</th>
                {row.vals.map((v, i) => (
                  <td class={i === 2 ? 'featured-col' : ''}>{v}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 style="margin-top:2.5em;">Monthly subscriptions</h3>
      <p class="csub">Lower upfront cost, cancel anytime. ~30% premium over annualised.</p>
      <div class="ctable-wrap">
        <table class="ctable">
          <thead>
            <tr>
              <th></th>
              <th>Free</th>
              <th>Starter</th>
              <th class="featured-col">Pro</th>
              <th>Agency</th>
            </tr>
          </thead>
          <tbody>
            {compareRowsMonthly.map(row => (
              <tr>
                <th>{row.label}</th>
                {row.vals.map((v, i) => (
                  <td class={i === 2 ? 'featured-col' : ''}>{v}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="csub" style="margin-top:1em;font-size:13px;">
        Monthly subscribers can cancel anytime. The same 12 modules unlock on every paid tier.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <div class="container">
      <h2>FAQ</h2>
      <div class="faq-list">
        {faqs.map(f => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</UtilitySuiteLayout>

<style>
  .container { max-width: 1100px; margin: 0 auto; padding: 0 36px; }
  .pricing-hero { padding: 72px 0 40px; }
  .pricing-hero .eyebrow { display: inline-block; background: var(--c-orange); color: var(--c-white); padding: 6px 14px; font-size: 12px; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; border-radius: var(--r-sm); }
  .pricing-hero h1 { font-size: 72px; line-height: 1; letter-spacing: -3px; font-weight: 900; margin: 20px 0 28px; }
  .pricing-hero .accent { background: var(--c-yellow); color: var(--c-black); padding: 0 10px; transform: skew(-3deg); display: inline-block; }
  .pricing-hero .lead { font-size: 20px; color: #444; max-width: 720px; line-height: 1.45; }
  @media (max-width: 700px) { .pricing-hero h1 { font-size: 44px; letter-spacing: -1.5px; } }

  /* Mission strip */
  .mission-strip { background: linear-gradient(135deg, #0a0a0a 0%, #141622 100%); color: #fff; padding: 32px 36px; border-top: 1px solid #1f2937; border-bottom: 1px solid #1f2937; }
  .mission-strip__inner { max-width: 1100px; margin: 0 auto; text-align: center; }
  .mission-strip__tagline { font-size: clamp(22px, 3vw, 32px); font-weight: 800; line-height: 1.15; letter-spacing: -0.5px; margin: 0 0 12px; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 16px; }
  .mission-strip__accent { color: #3D5AFE; text-shadow: 0 0 24px rgba(61, 90, 254, 0.35); }
  .mission-strip__sub { font-size: 14px; color: #cbd5e1; max-width: 760px; margin: 0 auto; line-height: 1.5; }

  .tier-grid { padding: 24px 0 64px; }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .tier { background: var(--c-white); border: 2px solid var(--c-black); border-radius: var(--r-md); padding: 28px 22px; position: relative; display: flex; flex-direction: column; }
  .tier h3 { font-size: 22px; font-weight: 800; margin-bottom: 4px; }
  .tier .sites { font-size: 13px; color: #666; margin-bottom: 18px; }
  .tier .price-row { display: flex; align-items: baseline; gap: 4px; margin-bottom: 4px; }
  .tier .price { font-size: 48px; font-weight: 900; letter-spacing: -2px; line-height: 1; }
  .tier .cadence { font-size: 14px; color: #666; }
  .tier .monthly { font-size: 12px; color: #666; margin-bottom: 18px; }
  .tier ul { list-style: none; margin: 8px 0 24px; flex: 1; font-size: 13.5px; }
  .tier li { padding: 6px 0 6px 20px; position: relative; line-height: 1.4; color: #333; }
  .tier li::before { content: '→'; position: absolute; left: 0; color: var(--c-orange); font-weight: 700; }
  .tier .btn { display: block; text-align: center; width: 100%; }
  .btn-monthly-link { display: block; text-align: center; margin-top: 10px; font-size: 13px; color: #666; text-decoration: underline; }
  .btn-monthly-link:hover { color: #000; }
  .tier.free { background: var(--c-yellow); }
  .tier.featured { background: var(--c-black); color: var(--c-white); transform: translateY(-8px); }
  .tier.featured h3, .tier.featured .price { color: var(--c-white); }
  .tier.featured .sites, .tier.featured .cadence, .tier.featured .monthly { color: #aaa; }
  .tier.featured li { color: #ddd; }
  .tier.featured .btn-pop { background: var(--c-orange); border-color: var(--c-orange); }
  .pop-tag { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: var(--c-orange); color: var(--c-white); padding: 4px 14px; border-radius: var(--r-sm); font-size: 10px; font-weight: 800; letter-spacing: 1px; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr 1fr; } .tier.featured { transform: none; } }
  @media (max-width: 540px) { .grid { grid-template-columns: 1fr; } }

  /* Lifetime CTA */
  .lifetime-cta { background: var(--c-black); color: var(--c-white); padding: 80px 0; border-top: 6px solid var(--c-orange); }
  .lcard h2 { font-size: 48px; line-height: 1.05; letter-spacing: -2px; margin: 16px 0 18px; color: var(--c-white); }
  .laccent { background: var(--c-yellow); color: var(--c-black); padding: 0 10px; display: inline-block; transform: skew(-3deg); }
  .llead { font-size: 18px; color: #bbb; max-width: 760px; line-height: 1.45; margin-bottom: 24px; }
  .llead strong { color: var(--c-white); }
  .ldisclosure { background: rgba(170, 0, 255, 0.10); border-left: 3px solid var(--c-orange); padding: 16px 20px; border-radius: var(--r-sm); font-size: 15px; color: #ccc; line-height: 1.5; max-width: 760px; margin-bottom: 0; }
  .ldisclosure strong { color: var(--c-white); }
  @media (max-width: 800px) { .lcard h2 { font-size: 32px; } }

  /* Compare */
  .compare { padding: 80px 0; background: var(--c-bg); }
  .compare h2 { font-size: 42px; font-weight: 900; letter-spacing: -1.5px; margin-bottom: 10px; }
  .csub { color: #555; margin-bottom: 32px; font-size: 16px; }
  .same-grid ul { list-style: none; columns: 2; column-gap: 32px; margin-bottom: 40px; }
  .same-grid li { padding: 6px 0; font-size: 15px; break-inside: avoid; }
  .same-grid strong { color: var(--c-black); }
  @media (max-width: 700px) { .same-grid ul { columns: 1; } }
  .ctable-wrap { overflow-x: auto; }
  .ctable { width: 100%; border-collapse: collapse; font-size: 15px; }
  .ctable th, .ctable td { padding: 14px 12px; text-align: left; border-bottom: 1px solid var(--c-border); }
  .ctable thead th { background: var(--c-black); color: var(--c-white); font-size: 13px; letter-spacing: 0.5px; text-transform: uppercase; }
  .ctable th:first-child { width: 22%; }
  .ctable td { font-weight: 500; }
  .ctable tbody .featured-col { background: rgba(170, 0, 255, 0.05); }
  .ctable tbody th { background: #fafafa; font-weight: 700; }

  /* FAQ */
  .faq { padding: 80px 0; }
  .faq h2 { font-size: 42px; font-weight: 900; letter-spacing: -1.5px; margin-bottom: 24px; }
  .faq-list { max-width: 820px; }
  .faq-item { border: 2px solid var(--c-black); border-radius: var(--r-md); margin-bottom: 10px; background: var(--c-white); padding: 16px 20px; }
  .faq-item summary { cursor: pointer; font-weight: 700; font-size: 16px; list-style: none; position: relative; padding-right: 36px; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; position: absolute; right: 0; top: -2px; font-size: 24px; color: var(--c-orange); font-weight: 900; }
  .faq-item[open] summary::after { content: '–'; }
  .faq-item p { margin-top: 10px; color: #444; font-size: 15px; line-height: 1.5; }
</style>
