---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Asteris Commerce — WordPress & WooCommerce plugins, built and supported by a Sydney team."
  description="A suite of WordPress & WooCommerce plugins you can buy today — SEO, security, checkout, subscriptions, wholesale, affiliates — plus custom plugin development for your business. One Sydney team, one vendor."
>

  <!-- ── Hero ────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container">
      <div class="eyebrow">★ Australian indie WP + WooCommerce plugin studio</div>
      <h1>
        The plugin suite for<br />
        <span class="accent-wp">WordPress</span> and <span class="accent-wc">WooCommerce</span>.
      </h1>
      <p class="lead">
        Seven shipping plugins you can buy and install today — <strong>SEO, security, performance, checkout, subscriptions, wholesale, affiliates</strong>. Each one replaces a whole stack of separate licences, under a single flat price.
      </p>
      <p class="lead">
        And when the plugin you need doesn't exist yet, we build it — <strong>custom WordPress &amp; WooCommerce development</strong> for your exact workflow, and you own the code.
      </p>
      <div class="hero-cta-row">
        <a href="#plugins" class="btn-hero btn-hero-primary">Browse the plugins →</a>
        <a href="/custom-plugins/" class="btn-hero btn-hero-secondary">Build a custom plugin</a>
      </div>
      <p class="no-vc">No VC. No marketing team. No growth hacker, by design.</p>
    </div>
  </section>

  <!-- ── Two ways to work with us ──────────────────────────────────── -->
  <section class="paths">
    <div class="container">
      <div class="section-head">
        <h2 class="section-h">Two ways to get the plugin you need.</h2>
        <p class="section-lead">
          Buy one of ours off the shelf, or have us build one around your business. Same Sydney team, same quality floor either way.
        </p>
      </div>

      <div class="paths-grid">
        <a href="#plugins" class="path path--buy">
          <div class="path-eye"><span class="ps">★</span> Ready to install</div>
          <h3>Buy a ready-made plugin.</h3>
          <p>
            Seven plugins, live today. Pick the ones that fit, install, done. <strong>Flat annual licence</strong> — no per-item fees, no marketplace middleman, no surprise upgrade gates.
          </p>
          <span class="path-cta">See the plugins →</span>
        </a>

        <a href="/custom-plugins/" class="path path--custom">
          <div class="path-eye"><span class="ps">★</span> Built to order</div>
          <h3>Commission a custom build.</h3>
          <p>
            Need something off-the-shelf can't do? We design and build a plugin around your operation — <strong>any industry, any feature</strong>. Fixed scope, fixed price, and the source is yours.
          </p>
          <span class="path-cta">Explore custom builds →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── Plugin suites — 2×2 grid ───────────────────────────────────── -->
  <section id="plugins" class="plugins">
    <div class="container">
      <div class="section-head">
        <h2 class="section-h">Six plugin suites — under one vendor.</h2>
        <p class="section-lead">
          Each plugin replaces a stack of separate licences. Each is built to the same Module Quality Protocol. All six are sold direct — no marketplaces, no resellers, no surprise upgrade gates.
        </p>
      </div>

      <div class="plugin-grid">
        <a href="/asteris-utility-suite/" class="plug plug--wp">
          <div class="plug-head">
            <div class="plug-eye"><span class="ps">★</span> Asteris Utility Suite</div>
            <span class="plug-stat plug-stat--live">Live · v1.0</span>
          </div>
          <h3>13 modules. For any WordPress site.</h3>
          <ul>
            <li><strong>Security + 2FA</strong> · SEO + AI · Performance · Forms · Asteris Links</li>
            <li>SMTP · Activity Log · Analytics + Pixels · Image Optimization · <strong>Insights</strong></li>
            <li>Backups + Migration · Code Snippets · WCAG accessibility scanner</li>
            <li>Replaces <strong>~$1,400/yr</strong> of separate plugin licences</li>
          </ul>
          <span class="plug-cta">asteriscommerce.com/asteris-utility-suite →</span>
        </a>

        <a href="https://asterisforwoocommerce.com" class="plug plug--wc" target="_blank" rel="noopener">
          <div class="plug-head">
            <div class="plug-eye"><span class="ps">★</span> Asteris for WooCommerce</div>
            <span class="plug-stat plug-stat--live">Live · v1.0</span>
          </div>
          <h3>20 modules. For every WooCommerce store.</h3>
          <ul>
            <li><strong>SEO</strong> · PDF Invoices · <strong>Variation Swatches</strong> · Wishlist</li>
            <li>Quote/Enquiry · Back in Stock · Side Cart · Sequential Order Numbers</li>
            <li>Filters · Min/Max Qty · Links · Trust Badges · Free Shipping Bar</li>
            <li>Replaces <strong>~$1,650/yr</strong> of separate plugin licences</li>
          </ul>
          <span class="plug-cta">asterisforwoocommerce.com →</span>
        </a>

        <a href="https://asteriscart.com" class="plug plug--cart" target="_blank" rel="noopener">
          <div class="plug-head">
            <div class="plug-eye"><span class="ps">★</span> Asteris Cart</div>
            <span class="plug-stat plug-stat--live">Live · v1.0</span>
          </div>
          <h3>21 modules. For the WooCommerce checkout funnel.</h3>
          <ul>
            <li>Side cart · free shipping bar · <strong>multi-step checkout</strong></li>
            <li>Urgency timer · trust badges · GDPR consent · express checkout</li>
            <li>Quote mode · order bumps · post-purchase upsells</li>
            <li>Replaces <strong>~$540/yr</strong> of CartFlows + FunnelKit + CheckoutWC</li>
          </ul>
          <span class="plug-cta">asteriscart.com →</span>
        </a>

        <a href="https://asterisaffiliates.com" class="plug plug--aff" target="_blank" rel="noopener">
          <div class="plug-head">
            <div class="plug-eye"><span class="ps">★</span> Asteris Affiliates</div>
            <span class="plug-stat plug-stat--live">Live · v1.0</span>
          </div>
          <h3>A full affiliate program. WP + WC. Self-hosted.</h3>
          <ul>
            <li><strong>Multi-tier commissions</strong> · recurring renewals · 3 payout methods</li>
            <li>Stripe Connect · PayPal · encrypted bank transfer</li>
            <li>15 email templates · refund-rate auto-suspend · vanity landing pages</li>
            <li>Replaces <strong>$300–$2,400/yr</strong> of AffiliateWP / Tapfiliate / Refersion</li>
          </ul>
          <span class="plug-cta">asterisaffiliates.com →</span>
        </a>

        <a href="https://asterisforwoocommerce.com/b2b-wholesale" class="plug plug--wholesale" target="_blank" rel="noopener">
          <div class="plug-head">
            <div class="plug-eye"><span class="ps">★</span> Asteris B2B Wholesale</div>
            <span class="plug-stat plug-stat--live">Live · v1.0</span>
          </div>
          <h3>Wholesale + B2B for WooCommerce.</h3>
          <ul>
            <li><strong>Wholesale roles</strong> · tiered &amp; dynamic pricing · per-customer pricing</li>
            <li>Request-a-quote · company accounts · tax handling · store credit</li>
            <li>BOGO + bulk discounts · order minimums · CSV price import</li>
            <li>Replaces <strong>~$348/yr</strong> of Wholesale Suite / B2BKing</li>
          </ul>
          <span class="plug-cta">asterisforwoocommerce.com/b2b-wholesale →</span>
        </a>

        <a href="https://asterisforwoocommerce.com/subscriptions" class="plug plug--subs" target="_blank" rel="noopener">
          <div class="plug-head">
            <div class="plug-eye"><span class="ps">★</span> Asteris Subscriptions</div>
            <span class="plug-stat plug-stat--live">Live · v1.0</span>
          </div>
          <h3>Recurring billing for WooCommerce.</h3>
          <ul>
            <li><strong>Reliable renewals</strong> · dunning that recovers failed payments</li>
            <li>Compliance-by-default cancellation · customer self-service portal</li>
            <li>Stripe + PayPal · prorating · pause / resume · free trials</li>
            <li>Replaces <strong>~$199/yr</strong> of WooCommerce Subscriptions</li>
          </ul>
          <span class="plug-cta">asterisforwoocommerce.com/subscriptions →</span>
        </a>
      </div>

      <p class="free-org">
        Prefer to start free? Four are on WordPress.org —
        <a href="https://wordpress.org/plugins/asteris-utility-suite/" target="_blank" rel="noopener">Utility Suite</a>,
        <a href="https://wordpress.org/plugins/asteris-subscriptions/" target="_blank" rel="noopener">Subscriptions</a>,
        <a href="https://wordpress.org/plugins/asteris-b2b-wholesale/" target="_blank" rel="noopener">B2B Wholesale</a>, and
        <a href="https://wordpress.org/plugins/asteris-affiliates/" target="_blank" rel="noopener">Affiliates</a>.
      </p>
    </div>
  </section>

  <!-- ── Round it out — Blocks + Blocks Pro ──────────────────────── -->
  <section class="roundout">
    <div class="container">
      <div class="section-head">
        <h2 class="section-h">Round it out.</h2>
        <p class="section-lead">
          Two add-on toolkits that compose with everything above. Use either or both.
        </p>
      </div>

      <div class="ro-grid">
        <a href="https://asterisblocks.com" class="ro-card ro-card--blocks" target="_blank" rel="noopener">
          <div class="ro-head">
            <div class="ro-eye"><span class="ps">★</span> Asteris Blocks</div>
            <span class="ro-stat ro-stat--free">Free · wp.org</span>
          </div>
          <h3>50 Gutenberg blocks. No upsells.</h3>
          <p>
            Hero, Pricing Table, FAQ with schema, Recipe Card, Countdown, Code Block, Image Hotspots, Map, QR Code, Before/After Slider, Table of Contents — and 39 more. Newsletter optin with Mailchimp / MailerLite / ConvertKit / Brevo adapters. <strong>No Pro tier, ever.</strong>
          </p>
          <span class="ro-cta">asterisblocks.com →</span>
        </a>

        <a href="https://asterisblocks.com/blocks-pro/" class="ro-card ro-card--patterns">
          <div class="ro-head">
            <div class="ro-eye"><span class="ps">★</span> Asteris Blocks Pro</div>
            <span class="ro-stat ro-stat--paid">Paid · from $49/yr</span>
          </div>
          <h3>73 premium block patterns.</h3>
          <p>
            Niche page templates, multimedia sections, audio/video blocks, premium e-commerce patterns, heroes, and composite sections. Drop them onto any page, replace the placeholder content, ship. <strong>Simple annual pricing</strong> — one standard price.
          </p>
          <span class="ro-cta">Read more about Blocks Pro →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── Custom plugins for business ──────────────────────────────── -->
  <section class="custombuild">
    <div class="container">
      <div class="cb-head">
        <div class="cb-eye"><span class="ps">★</span> Bespoke builds · for business</div>
        <h2 class="section-h">Custom plugins, built around your business.</h2>
        <p class="section-lead">
          When off-the-shelf won't cut it, we build the WordPress &amp; WooCommerce plugin your operation actually needs — modals, shipping, integrations, booking, memberships, pricing engines, AI, whatever the workflow demands. You approve a fixed scope and a fixed price before we start, and the source is yours at the end.
        </p>
      </div>

      <div class="cb-tiles">
        <div class="cb-tile">
          <span class="cb-tile-ico">🏭</span>
          <h3>Any industry</h3>
          <p>Retail, hospitality, real estate, health, education, B2B, trades — we start from your workflow, not a template.</p>
        </div>
        <div class="cb-tile">
          <span class="cb-tile-ico">🧩</span>
          <h3>Any feature</h3>
          <p>Checkout, shipping, subscriptions, integrations, automation, memberships, dashboards — if WP or WC can do it, we build it.</p>
        </div>
        <div class="cb-tile">
          <span class="cb-tile-ico">📋</span>
          <h3>Fixed scope, fixed price</h3>
          <p>A written spec and a number you approve up front. No hourly black holes, no scope-creep invoices.</p>
        </div>
        <div class="cb-tile">
          <span class="cb-tile-ico">🔑</span>
          <h3>You own the code</h3>
          <p>Full source and IP delivered. No per-site licence, no lock-in, no holding your build hostage.</p>
        </div>
      </div>

      <div class="cb-foot">
        <ul class="cb-trust">
          <li><strong>7</strong> plugins shipped</li>
          <li><strong>5 yrs</strong> WP/WC client work</li>
          <li><strong>Sydney</strong>-built</li>
          <li><strong>You</strong> own the code</li>
        </ul>
        <a href="/custom-plugins/" class="btn btn-large btn-pop cb-cta">Explore custom plugins →</a>
      </div>
    </div>
  </section>

  <!-- ── Mission strip · "Less cost, more inclusions" ─────────────── -->
  <section class="mission-strip">
    <div class="container">
      <div class="mission-grid">
        <div class="mission-headline">
          <div class="mission-eyebrow">Our mission</div>
          <h2 class="mission-h">More inclusions. Less cost. Australian-built.</h2>
          <p class="mission-lead">
            One vendor relationship replaces stacks of paid plugins. Across the suite, we replace
            <strong>~$5,900/yr</strong> of competing tools for <strong>~$600–$2,000/yr</strong>.
            We're honest about what's in each plugin and what's not — no "Pro tier" surprises mid-trial.
          </p>
        </div>
        <div class="mission-table">
          <div class="mission-row mission-row--head"><span>Product</span><span>Replaces</span><span>Asteris price</span></div>
          <div class="mission-row"><span><strong>Asteris Utility Suite</strong></span><span>~$1,400/yr</span><span>$149–$549/yr</span></div>
          <div class="mission-row"><span><strong>Asteris for WC</strong></span><span>~$1,650/yr</span><span>$149–$549/yr</span></div>
          <div class="mission-row"><span><strong>Asteris Cart</strong></span><span>~$540/yr</span><span>$99–$399/yr</span></div>
          <div class="mission-row"><span><strong>Asteris Affiliates</strong></span><span>$300–$2,400/yr</span><span>$149–$549/yr</span></div>
          <div class="mission-row"><span><strong>Asteris Blocks</strong></span><span>~$400/yr</span><span><strong>Free forever</strong></span></div>
          <div class="mission-row mission-row--total"><span><strong>Full stack</strong></span><span><strong>~$5,900/yr</strong></span><span><strong>~$600–$2,000/yr</strong></span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Why six products ────────────────────────────────────────────── -->
  <section class="why">
    <div class="container">
      <div class="why-inner">
        <h2>Why six products, one company.</h2>
        <p>
          Most WordPress sites don't run WooCommerce. Most WooCommerce stores have plugin needs that go beyond what a generic WP plugin covers. And the WooCommerce checkout has its own deep stack of category-specific plugins (cart drawer, urgency, multi-step, express, GDPR) that don't belong inside a general-purpose WC suite.
        </p>
        <p>
          <strong>Asteris Utility Suite</strong> covers what any WP site needs (security, SEO, backups, email). <strong>Asteris for WooCommerce</strong> covers what a WC store specifically needs (product page, conversion, fulfilment). <strong>Asteris Cart</strong> covers the checkout funnel itself. <strong>Asteris Affiliates</strong> turns customers into a sales channel. <strong>Wholesale</strong> and <strong>Subscriptions</strong> handle B2B and recurring revenue. <strong>Asteris Blocks + Blocks Pro</strong> round out content design. And when none of those is the answer, we build a <strong>custom plugin</strong> for the job.
        </p>
        <p>
          Some modules genuinely overlap — SEO + AI, Analytics, Links, AI library, Activity Log. Those are built once and vendored across every plugin, so the same code ships everywhere. Most modules don't overlap, which is why they're separate plugins instead of one mega-plugin nobody asked for.
        </p>
        <p>
          One company means one vendor relationship, one support inbox, one philosophy. Six products means each one stays focused on its actual buyer.
        </p>
      </div>
    </div>
  </section>

  <!-- ── About strip ─────────────────────────────────────────────────── -->
  <section class="about-strip">
    <div class="container">
      <div class="about-inner">
        <div class="about-text">
          <h3>About the company</h3>
          <p>
            Asteris Commerce is the products division of My Cosmic Message Pty Ltd, an Australian proprietary limited company (ACN 652 358 159, ABN 30 652 358 159) incorporated in 2021. Sole director Nick Lord, based in Sydney. The same Pty Ltd has been operating Orion Web Service (full-stack WP and WC development and hosting) since 2021. Asteris was built from five years of patterns observed running real client stores. No VC. No outside funding. No growth hacker. Funded by Orion Web Service revenue plus standing subscriptions.
          </p>
          <a href="/about" class="btn btn-large">Read more →</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ──────────────────────────────────────────────────────── */
  .hero { padding: 70px 0 50px; }
  .eyebrow {
    display: inline-block;
    background: var(--c-yellow);
    padding: 4px 12px;
    border-radius: var(--r-sm);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 24px;
    color: var(--c-black);
  }
  h1 {
    font-size: 76px;
    line-height: 1.0;
    letter-spacing: -2.5px;
    margin-bottom: 26px;
    font-weight: 900;
  }
  h1 .accent-wp { color: #3D5AFE; }
  h1 .accent-wc { color: #FF5B3F; }
  .lead { font-size: 21px; color: #333; line-height: 1.55; margin-bottom: 14px; max-width: 880px; }
  .lead strong { color: var(--c-black); }
  .hero-cta-row { display: flex; gap: 14px; flex-wrap: wrap; margin: 28px 0 22px; }
  .btn-hero {
    display: inline-block;
    padding: 14px 28px;
    border-radius: 10px;
    font-size: 17px;
    font-weight: 700;
    text-decoration: none;
    border: 2px solid var(--c-black);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
    white-space: nowrap;
  }
  .btn-hero-primary {
    background: var(--c-violet, #AA00FF);
    color: #fff;
    border-color: var(--c-violet, #AA00FF);
    box-shadow: 4px 4px 0 var(--c-black);
  }
  .btn-hero-primary:hover {
    transform: translate(-3px, -3px);
    box-shadow: 7px 7px 0 var(--c-black);
  }
  .btn-hero-secondary {
    background: #fff;
    color: var(--c-black);
    box-shadow: 4px 4px 0 var(--c-black);
  }
  .btn-hero-secondary:hover {
    transform: translate(-3px, -3px);
    box-shadow: 7px 7px 0 var(--c-violet, #AA00FF);
    color: var(--c-violet, #AA00FF);
  }
  .no-vc { font-size: 17px; color: var(--c-muted); font-style: italic; margin-top: 10px; }
  @media (max-width: 700px) {
    h1 { font-size: 44px; letter-spacing: -1.5px; }
    .lead { font-size: 17px; }
  }

  /* ── Section heads ─────────────────────────────────────────────── */
  .section-head { margin-bottom: 38px; max-width: 880px; }
  .section-h {
    font-size: 38px;
    line-height: 1.1;
    letter-spacing: -1.4px;
    margin: 0 0 14px;
    font-weight: 900;
    color: var(--c-black);
  }
  .section-lead { font-size: 18px; line-height: 1.55; color: #444; margin: 0; }
  @media (max-width: 700px) { .section-h { font-size: 28px; letter-spacing: -1px; } .section-lead { font-size: 17px; } }

  /* ── Two paths ─────────────────────────────────────────────────── */
  .paths { padding: 40px 0 20px; }
  .paths-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .path {
    background: #fff;
    border: 2px solid var(--c-black);
    border-top: 6px solid var(--c, var(--c-violet, #AA00FF));
    border-radius: var(--r-lg);
    padding: 30px 32px;
    text-decoration: none;
    color: var(--c-text);
    display: flex;
    flex-direction: column;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  .path:hover { transform: translate(-3px, -3px); box-shadow: 6px 6px 0 var(--c); }
  .path--buy { --c: #FF5B3F; }
  .path--custom { --c: #AA00FF; }
  .path-eye {
    font-size: 15px; font-weight: 700; color: var(--c);
    text-transform: uppercase; letter-spacing: 0.5px;
    display: flex; align-items: center; gap: 7px; margin-bottom: 12px;
  }
  .path-eye .ps { font-size: 18px; line-height: 1; }
  .path h3 { font-size: 26px; line-height: 1.15; letter-spacing: -0.8px; margin: 0 0 12px; font-weight: 900; color: var(--c-black); }
  .path p { font-size: 17px; line-height: 1.6; color: #444; margin: 0 0 18px; }
  .path p strong { color: var(--c-black); }
  .path-cta { margin-top: auto; font-weight: 700; color: var(--c); font-size: 17px; }
  @media (max-width: 800px) { .paths-grid { grid-template-columns: 1fr; } }

  /* ── Plugin grid 2×2 ─────────────────────────────────────────── */
  .plugins { padding: 60px 0; }
  .plugin-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .plug {
    background: #fff;
    border: 2px solid var(--c-black);
    border-top: 6px solid var(--c, var(--c-violet, #AA00FF));
    border-radius: var(--r-lg);
    padding: 26px 28px;
    color: var(--c-text);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  .plug:hover {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--c);
  }
  .plug--wp { --c: #3D5AFE; }
  .plug--wc { --c: #FF5B3F; }
  .plug--cart { --c: #00C853; }
  .plug--aff { --c: #06D6A0; border-color: #06D6A0; }
  .plug--wholesale { --c: #475569; }
  .plug--subs { --c: #EC4899; }
  .plug-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }
  .plug-eye {
    font-size: 15px; font-weight: 700; color: var(--c);
    text-transform: uppercase; letter-spacing: 0.5px;
    display: flex; align-items: center; gap: 7px;
  }
  .plug-eye .ps { font-size: 18px; color: var(--c); line-height: 1; }
  .plug-stat {
    font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;
    padding: 3px 10px; border-radius: 999px; border: 1.5px solid currentColor;
    background: rgba(255,255,255,0.9); white-space: nowrap;
  }
  .plug-stat--live { color: #2e7d32; }
  .plug-stat--dev { color: #c0392b; }
  .plug-stat--planned { color: #888; }
  .plug h3 {
    font-size: 22px; line-height: 1.2; letter-spacing: -0.6px;
    margin: 0 0 14px; font-weight: 900; color: var(--c-black);
  }
  .plug ul { list-style: none; padding: 0; margin: 0 0 18px; }
  .plug li {
    font-size: 16px; line-height: 1.55; color: #444;
    padding: 5px 0 5px 18px; position: relative;
  }
  .plug li::before { content: '✓'; position: absolute; left: 0; color: var(--c); font-weight: 800; }
  .plug li strong { color: var(--c-black); }
  .plug-cta { margin-top: auto; font-weight: 700; color: var(--c); font-size: 17px; }
  @media (max-width: 800px) { .plugin-grid { grid-template-columns: 1fr; } }
  .free-org {
    margin: 26px 0 0; font-size: 17px; line-height: 1.6; color: #444;
    background: #fafbfd; border: 1px solid #e0e3eb; border-radius: 10px;
    padding: 16px 20px; text-align: center;
  }
