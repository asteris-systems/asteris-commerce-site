---
import Layout from '../layouts/Layout.astro';

const CONTACT = '#enquire';

// What we build — plugin types (the user asked for "all plugin types").
const pluginTypes = [
  { icon: '🪟', title: 'Modals & popups', ex: 'Exit-intent, age-gates, announcements, upsell windows, cookie-consent, lightboxes.' },
  { icon: '🚚', title: 'Shipping & fulfilment', ex: 'Live carrier rates, table/zone rules, label printing, local pickup, dispatch routing.' },
  { icon: '🛒', title: 'Checkout & cart', ex: 'Custom fields, conditional fees, one-page checkout, order bumps, save-for-later.' },
  { icon: '💳', title: 'Payments & subscriptions', ex: 'Gateways, deposits & part-pay, recurring billing, split payments, wallets.' },
  { icon: '🎬', title: 'Multimedia', ex: 'Galleries, audio/video players, 3D & AR product viewers, playlists, streaming.' },
  { icon: '📅', title: 'Booking & scheduling', ex: 'Appointments, rentals, events, room/resource calendars, availability rules.' },
  { icon: '📝', title: 'Forms & data capture', ex: 'Multi-step, conditional logic, file uploads, e-sign, CRM sync, calculators.' },
  { icon: '🔌', title: 'Integrations & APIs', ex: 'ERP, CRM, accounting (Xero/QuickBooks), couriers, marketplaces, webhooks.' },
  { icon: '🔐', title: 'Memberships & access', ex: 'Paywalls, content drip, role gating, course access, partner portals.' },
  { icon: '🏷️', title: 'Pricing & quoting', ex: 'B2B/wholesale tiers, RFQ, product configurators, dynamic & bulk pricing.' },
  { icon: '📊', title: 'Reporting & dashboards', ex: 'Custom analytics, scheduled exports, KPI widgets, admin overview screens.' },
  { icon: '⚙️', title: 'Automation & workflows', ex: 'Triggers, cron jobs, status automations, notifications, queue processing.' },
  { icon: '🔁', title: 'Import / export / sync', ex: 'Migrations, two-way sync, scheduled feeds, bulk product/customer tooling.' },
  { icon: '🤖', title: 'AI features', ex: 'Content generation, recommendations, search, support agents, BYO-key models.' },
  { icon: '🚀', title: 'Performance & infra', ex: 'Object caching, background jobs, custom search/index, query optimisation.' },
  { icon: '🧰', title: 'Admin & ops tools', ex: 'Custom post types, bulk operations, internal tools, ACF-style field engines.' },
];

// Any industry.
const industries = [
  'Retail & eCommerce', 'Hospitality & food', 'Real estate', 'Health & medical',
  'Education & e-learning', 'Professional services', 'Manufacturing & B2B', 'Events & ticketing',
  'Fitness & wellness', 'Finance & insurance', 'Nonprofit & charity', 'Travel & tourism',
  'Automotive', 'Beauty & salons', 'SaaS & technology', 'Trades & local services',
];

// The process — audited end-to-end.
const steps = [
  { n: '01', t: 'Discovery & scoping call', d: 'A free call to map the use case, constraints, integrations and success criteria. NDA on request before anything is shared.' },
  { n: '02', t: 'Fixed proposal & quote', d: 'A written spec — features, data model, milestones, timeline and a fixed price. No hourly black holes, no surprise invoices.' },
  { n: '03', t: 'Architecture & design', d: 'Data model, admin UX, security model and a compatibility plan (HPOS, Block Checkout, Multisite, your theme + plugin stack).' },
  { n: '04', t: 'Build on staging', d: 'We build on a staging copy with milestone demos, so you see and steer it as it comes together — never blind until the end.' },
  { n: '05', t: 'QA, security & compat', d: 'Code review, Plugin Check, accessibility (WCAG 2.1 AA), a performance budget, and testing across themes + PHP 8.1–8.3.' },
  { n: '06', t: 'Deploy & handover', d: 'Installed on your site, with full documentation and the complete source. You own the code outright — no lock-in.' },
  { n: '07', t: 'Support & care (optional)', d: 'Ongoing WP/WC compatibility updates, fixes, small monthly changes, monitoring and priority support under an SLA.' },
];

// Everything included — the quality floor.
const included = [
  'You own the code outright — no per-site licence, no lock-in',
  'Full source + written documentation delivered',
  'Security-first: nonces, sanitisation, capability & permission checks',
  'WordPress Coding Standards + Plugin Check clean',
  'HPOS, Block Cart/Checkout & Multisite compatibility as needed',
  'Accessibility (WCAG 2.1 AA) built in, not bolted on',
  'Performance budget — assets load only where the feature runs',
  'Optional self-hosted auto-update channel for your team',
  'Clean uninstall — no orphaned tables or options',
  'Translation-ready (i18n) out of the box',
  'Tested across 6 themes + PHP 8.1, 8.2, 8.3',
  '30-day warranty on every build',
  'NDA & confidentiality as standard',
  'Staging-first — we never cowboy on production',
  'GDPR / privacy handled by design',
  'Works with your existing stack — no rip-and-replace',
];

const why = [
  { t: 'We ship real products', d: 'Seven shipping WordPress & WooCommerce plugins. We build maintainable software, not throwaway one-offs that rot after handover.' },
  { t: 'Operator-built', d: 'Five years running real client stores through our sister business, Orion Web Service. We have felt the pain we build against.' },
  { t: 'You own it', d: 'Most agencies licence the code back to you and hold it hostage. Your build is yours — source, IP, all of it.' },
  { t: 'Fixed scope, fixed price', d: 'You approve a written spec and a number before we start. No metered hours, no scope-creep invoices.' },
  { t: 'One team, end to end', d: 'The people who build it are the people who support it. No handing you to a different support queue.' },
];

// Build pricing tiers — "from" anchors within real market bands.
const tiers = [
  {
    name: 'Essential', price: 'from $1,200', featured: false,
    best: 'A focused, single-purpose plugin.',
    points: ['Modals, utilities, small admin tools, tweaks', 'Typically 1–2 weeks', 'Full source + docs — you own it', '30-day warranty'],
  },
  {
    name: 'Standard', price: 'from $3,500', featured: true,
    best: 'A full-featured WordPress plugin.',
    points: ['Custom post types, settings, admin UI', 'Third-party API / service integrations', 'Typically 2–4 weeks', 'Everything in Essential'],
  },
  {
    name: 'WooCommerce', price: 'from $6,500', featured: false,
    best: 'Store-grade commerce features.',
    points: ['Checkout, shipping, pricing, subscriptions', 'HPOS + Block Checkout compatible', 'Typically 3–6 weeks', 'Everything in Standard'],
  },
  {
    name: 'Enterprise', price: 'Custom quote', featured: false,
    best: 'Heavy integrations & multi-system builds.',
    points: ['ERP / CRM / large API integrations', 'Multisite & high-volume ready', 'Security & load review', 'Dedicated build + SLA'],
  },
];

const faqs = [
  { q: 'Do I actually own the plugin?', a: '100%. You get the full source and the IP. No per-site licence, no usage caps, no us holding the keys.' },
  { q: 'How long does a build take?', a: 'A focused utility or modal is typically 1–2 weeks. A larger integration or commerce feature is usually 4–8 weeks. You get a firm timeline in the proposal.' },
  { q: 'Can you work with my existing site and plugins?', a: 'Yes. We build to fit your current theme and plugin stack, test against it, and avoid conflicts. No rebuild required.' },
  { q: 'Will it survive WordPress / WooCommerce updates?', a: 'Every build is written to current standards and tested across PHP versions. A Care plan keeps it actively maintained against core, WC and PHP changes.' },
  { q: 'Can you publish it to WordPress.org?', a: 'Yes, where it makes sense — we know the review process (we ship plugins there) and can prepare and submit a compliant release.' },
  { q: 'What about confidentiality and my data?', a: 'NDA on request before scoping. Builds are GDPR-aware by design, and we never expose customer data we do not need.' },
  { q: 'I only need a tweak to an existing plugin — can you help?', a: 'Yes. Small fixes, extensions and "make this plugin do X" changes are very welcome, usually as a one-time job or under a Care plan.' },
  { q: 'Do you do rush jobs?', a: 'Yes, with a rush fee and a confirmed slot. Tell us the deadline on the scoping call.' },
];

// JSON-LD schema for rich results.
const ORIGIN = 'https://asteriscommerce.com';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      'name': 'Custom WordPress & WooCommerce plugin development',
      'serviceType': 'WordPress and WooCommerce plugin development',
      'description': 'Bespoke WordPress and WooCommerce plugin development for any industry and any feature — modals, shipping, multimedia, integrations, automation and more. Fixed-scope builds you own outright, with optional monthly support.',
      'provider': { '@type': 'Organization', 'name': 'Asteris Commerce', 'url': ORIGIN },
      'areaServed': 'Worldwide',
      'url': ORIGIN + '/custom-plugins/',
      'offers': { '@type': 'Offer', 'priceCurrency': 'USD', 'price': '1200', 'url': ORIGIN + '/custom-plugins/' },
    },
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': ORIGIN + '/' },
        { '@type': 'ListItem', 'position': 2, 'name': 'Custom Plugins', 'item': ORIGIN + '/custom-plugins/' },
      ],
    },
    {
      '@type': 'FAQPage',
      'mainEntity': faqs.map((f) => ({
        '@type': 'Question',
        'name': f.q,
        'acceptedAnswer': { '@type': 'Answer', 'text': f.a },
      })),
    },
  ],
};
---

<Layout
  title="Custom WordPress & WooCommerce Plugin Development | Asteris Commerce"
  description="Custom WordPress & WooCommerce plugin development for any industry — modals, shipping, integrations and more. Fixed-scope builds you own, plus optional support."
  ogImage="/og-custom-plugins.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <!-- HERO -->
  <section class="cp-hero">
    <div class="container">
      <p class="cp-eyebrow">★ Asteris Commerce · Bespoke builds</p>
      <h1>Custom WordPress &amp; WooCommerce plugins,<br class="cp-br" /> built for exactly how <em>your</em> business works.</h1>
      <p class="lead">Off-the-shelf almost fits? We build the WordPress &amp; WooCommerce plugin that fits exactly — for any industry, any feature: modals, shipping, multimedia, integrations, automation and everything in between. Fixed scope, fixed price, and you own the code.</p>
      <div class="cp-hero-cta">
        <a href={CONTACT} class="btn btn-large btn-pop">Book a free scoping call →</a>
        <a href="#how" class="btn btn-large btn-outline">See how it works ↓</a>
      </div>
      <ul class="cp-trust">
        <li><strong>7</strong> plugins shipped</li>
        <li><strong>5 yrs</strong> WP/WC client work</li>
        <li><strong>You</strong> own the code</li>
        <li><strong>Sydney</strong>-built</li>
      </ul>
    </div>
  </section>

  <!-- INTRO / keyword anchor -->
  <section class="cp-section cp-alt">
    <div class="container cp-intro">
      <h2>WordPress &amp; WooCommerce development, delivered as a plugin you own</h2>
      <p class="cp-sub">
        We&rsquo;re a Sydney-based <strong>WordPress &amp; WooCommerce development</strong> team offering <strong>custom plugin development services</strong> — from a single modal to a full WooCommerce shipping or checkout system. Hire us as your <strong>WordPress plugin developer</strong> for a fixed-scope build, and walk away owning the code: no per-site licence, no lock-in.
      </p>
    </div>
  </section>

  <!-- WHAT WE BUILD -->
  <section class="cp-section">
    <div class="container">
      <h2>Any plugin type</h2>
      <p class="cp-sub">If WordPress or WooCommerce can do it, we can build it. A sample of what we&rsquo;re asked for &mdash; yours probably isn&rsquo;t on the list, and that&rsquo;s the point.</p>
      <div class="cp-grid">
        {pluginTypes.map((p) => (
          <div class="cp-card">
            <span class="cp-card-icon">{p.icon}</span>
            <h3>{p.title}</h3>
            <p>{p.ex}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="cp-section cp-alt">
    <div class="container">
      <h2>Any industry</h2>
      <p class="cp-sub">We&rsquo;ve built for stores, studios, clinics, agencies and B2B operators. Custom means we start from your workflow, not a template.</p>
      <ul class="cp-chips">
        {industries.map((i) => <li>{i}</li>)}
      </ul>
      <p class="cp-note">Don&rsquo;t see yours? <a href={CONTACT}>Tell us about it →</a></p>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how" class="cp-section">
    <div class="container">
      <h2>How it works</h2>
      <p class="cp-sub">A clear, low-risk path from idea to a plugin running on your site &mdash; with you steering at every step.</p>
      <ol class="cp-steps">
        {steps.map((s) => (
          <li>
            <span class="cp-step-n">{s.n}</span>
            <div>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- INCLUDED -->
  <section class="cp-section cp-dark">
    <div class="container">
      <h2>Every build includes</h2>
      <p class="cp-sub cp-sub-light">The quality floor on every project &mdash; the things cheap freelancers skip and you only discover later.</p>
      <ul class="cp-checks">
        {included.map((c) => <li><span class="cp-tick">✓</span>{c}</li>)}
      </ul>
    </div>
  </section>

  <!-- WHY US -->
  <section class="cp-section cp-alt">
    <div class="container">
      <h2>Why Asteris, not a random freelancer</h2>
      <div class="cp-why">
        {why.map((w) => (
          <div class="cp-why-item">
            <h3>{w.t}</h3>
            <p>{w.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="cp-section">
    <div class="container cp-faq-wrap">
      <h2>Questions, answered</h2>
      <div class="cp-faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- PRICING — tiered table + Care add-on -->
  <section class="cp-section cp-pricing">
    <div class="container">
      <h2>Transparent pricing</h2>
      <p class="cp-sub">Every build is a fixed quote you approve up front &mdash; and you own the code. These are starting points by complexity; your exact price is set on the free scoping call.</p>
      <div class="cp-tiers">
        {tiers.map((t) => (
          <div class={'cp-tier' + (t.featured ? ' cp-tier-featured' : '')}>
            {t.featured && <span class="cp-tier-flag">Most common</span>}
            <h3>{t.name}</h3>
            <p class="cp-tier-price">{t.price}</p>
            <p class="cp-tier-best">{t.best}</p>
            <ul>
              {t.points.map((pt) => <li>{pt}</li>)}
            </ul>
            <a href={CONTACT} class={'btn ' + (t.featured ? 'btn-pop' : 'btn-outline')}>Get a quote →</a>
          </div>
        ))}
      </div>

      <div class="cp-care">
        <div class="cp-care-text">
          <span class="cp-care-tag">★ Optional Care plan</span>
          <h3>Keep it alive &mdash; from <strong>$99/mo</strong></h3>
          <p>Add ongoing support to any build: WP / WC / PHP compatibility updates, bug fixes, small monthly changes, priority support with an SLA, and uptime &amp; error monitoring. Cancel anytime.</p>
        </div>
        <a href={CONTACT} class="btn btn-large btn-outline">Add a Care plan →</a>
      </div>

      <p class="cp-note cp-note-center">All prices in USD &middot; fixed quote after a free, no-obligation scoping call &middot; you own the code outright.</p>
    </div>
  </section>

  <!-- LICENCE SERVER OFFERING -->
  <section class="cp-section cp-alt">
    <div class="container">
      <h2>Run your own licence server</h2>
      <p class="cp-sub">Selling premium plugins, themes or software through Lemon Squeezy, Gumroad or Paddle? They take <strong>5&ndash;15% of every sale &mdash; forever</strong>. We set up your own self-hosted licence server &mdash; licence keys, activation, automatic updates and Stripe checkout &mdash; so you keep your revenue and pay near-zero running costs.</p>

      <div class="cp-tiers" style="justify-content:center;">
        <div class="cp-tier cp-tier-featured" style="max-width:480px;width:100%;">
          <span class="cp-tier-flag">One-time install</span>
          <h3>Licence server</h3>
          <p class="cp-tier-price">From $750</p>
          <p class="cp-tier-best">Fully installed &amp; working across your product suite</p>
          <ul>
            <li>Licence-key issue, activation &amp; deactivation (multi-site)</li>
            <li>Automatic plugin / theme updates with signed R2 / S3 downloads</li>
            <li>Stripe checkout + a customer account &amp; downloads portal</li>
            <li>Version management, update gating &amp; expiry handling</li>
            <li>Runs on your own hosting &mdash; cents per month, not a % of sales</li>
            <li>One-time setup, fully working &mdash; you own it outright</li>
          </ul>
          <a href={CONTACT} class="btn btn-pop">Get a quote &rarr;</a>
        </div>
      </div>

      <p class="cp-note cp-note-center">Do the maths: a marketplace taking 10% of $100k/yr in sales costs you <strong>$10,000 every year</strong>. Your own licence server is a one-time install from <strong>$750</strong> &mdash; it pays for itself in weeks.</p>
    </div>
  </section>

  <!-- ENQUIRY FORM -->
  <section id="enquire" class="cp-section cp-enquire">
    <div class="container cp-enquire-wrap">
      <h2>Tell us what you need</h2>
      <p class="cp-sub">Sketch the idea in a few lines. We&rsquo;ll reply within one business day with next steps and book a free scoping call &mdash; no obligation.</p>
      <p id="cp-thanks" class="cp-thanks" hidden>✓ Thanks — your enquiry is on its way. We&rsquo;ll reply within one business day.</p>
      <script is:inline>
        if (location.search.indexOf('sent=1') !== -1) {
          var t = document.getElementById('cp-thanks');
          if (t) { t.hidden = false; t.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
        }
      </script>
      <form class="cp-form" action="https://formsubmit.co/support@asteriscommerce.com" method="POST">
        <!-- FormSubmit config -->
        <input type="hidden" name="_subject" value="Custom plugin enquiry — asteriscommerce.com" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value="https://asteriscommerce.com/custom-plugins/?sent=1" />
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="cp-honey" aria-hidden="true" />

        <div class="cp-field-row">
          <label class="cp-field">
            <span>Your name *</span>
            <input type="text" name="Name" required autocomplete="name" />
          </label>
          <label class="cp-field">
            <span>Email *</span>
            <input type="email" name="Email" required autocomplete="email" />
          </label>
        </div>
        <div class="cp-field-row">
          <label class="cp-field">
            <span>Website (optional)</span>
            <input type="url" name="Website" placeholder="https://" />
          </label>
          <label class="cp-field">
            <span>Plugin type</span>
            <select name="Plugin type">
              <option>Not sure yet</option>
              {pluginTypes.map((p) => <option>{p.title}</option>)}
              <option>Tweak to an existing plugin</option>
              <option>Something else</option>
            </select>
          </label>
        </div>
        <div class="cp-field-row">
          <label class="cp-field">
            <span>Industry</span>
            <select name="Industry">
              <option>Not listed / other</option>
              {industries.map((i) => <option>{i}</option>)}
            </select>
          </label>
          <label class="cp-field">
            <span>Budget range</span>
            <select name="Budget">
              <option>Not sure yet</option>
              <option>Under $1,500</option>
              <option>$1,500 – $5,000</option>
              <option>$5,000 – $15,000</option>
              <option>$15,000+</option>
              <option>Ongoing / Care plan</option>
            </select>
          </label>
        </div>
        <label class="cp-field">
          <span>What do you need the plugin to do? *</span>
          <textarea name="Details" rows="5" required placeholder="The problem, the must-have features, anything it has to integrate with, and any deadline."></textarea>
        </label>
        <div class="cp-form-foot">
          <button type="submit" class="btn btn-large btn-pop">Send enquiry →</button>
          <p>Goes straight to <strong>support@asteriscommerce.com</strong>. We never share your details.</p>
        </div>
      </form>
    </div>
  </section>
</Layout>

<style>
  .container { max-width: var(--max-w); margin: 0 auto; padding: 0 var(--gutter); }

  /* HERO */
  .cp-hero { background: var(--c-black); color: var(--c-white); padding: 7rem 0 5rem; }
  .cp-eyebrow { color: var(--c-yellow); font-weight: 700; letter-spacing: .12em; text-transform: uppercase; font-size: .85rem; margin: 0 0 1.2rem; }
  .cp-hero h1 { font-size: clamp(2.4rem, 1.6rem + 3.4vw, 4.2rem); line-height: 1.05; letter-spacing: -.02em; margin: 0 0 1.4rem; color: #fff; }
  .cp-hero h1 em { color: var(--c-violet); font-style: normal; }
  .cp-hero .lead { font-size: clamp(1.05rem, 1rem + .4vw, 1.35rem); color: #cfcfcf; max-width: 60ch; line-height: 1.55; margin: 0 0 2rem; }
  .cp-hero-cta { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 2.4rem; }
  .cp-hero .btn-outline { color: #fff; border-color: #fff; }
  .cp-trust { list-style: none; display: flex; flex-wrap: wrap; gap: 1.2rem 2.4rem; padding: 0; margin: 0; border-top: 1px solid #222; padding-top: 1.6rem; }
  .cp-trust li { color: #aaa; font-size: .95rem; }
  .cp-trust strong { color: #fff; font-size: 1.15rem; margin-right: .35rem; }

  /* SECTIONS */
  .cp-section { padding: 4.5rem 0; }
  .cp-alt { background: var(--c-bg); }
  .cp-section h2 { font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.6rem); letter-spacing: -.02em; margin: 0 0 .6rem; }
  .cp-sub { color: var(--c-muted); font-size: 1.1rem; max-width: 62ch; margin: 0 0 2.4rem; line-height: 1.55; }
  .cp-sub-light { color: #bdbdbd; }
  .cp-intro { max-width: 840px; margin: 0 auto; text-align: center; }
  .cp-intro h2 { margin-bottom: 1rem; }
  .cp-intro .cp-sub { margin: 0 auto; }

  /* WHAT WE BUILD GRID */
  .cp-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .cp-card { border: 2px solid var(--c-black); border-radius: var(--r-lg); background: #fff; padding: 20px; transition: transform .12s, box-shadow .12s; }
  .cp-card:hover { transform: translate(-3px, -3px); box-shadow: var(--pop-shadow); }
  .cp-card-icon { font-size: 1.6rem; display: block; margin-bottom: .5rem; }
  .cp-card h3 { font-size: 1.05rem; margin: 0 0 .4rem; }
  .cp-card p { color: var(--c-muted); font-size: .9rem; line-height: 1.5; margin: 0; }

  /* INDUSTRY CHIPS */
  .cp-chips { list-style: none; display: flex; flex-wrap: wrap; gap: 12px; padding: 0; margin: 0 0 1.6rem; }
  .cp-chips li { border: 2px solid var(--c-black); border-radius: 999px; padding: 9px 18px; font-weight: 600; font-size: .95rem; background: #fff; }
  .cp-note { color: var(--c-muted); font-size: 1rem; }
  .cp-note a { color: var(--c-violet); font-weight: 700; text-decoration: none; }
  .cp-note-center { text-align: center; margin-top: 1.8rem; }

  /* STEPS */
  .cp-steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .cp-steps li { display: flex; gap: 20px; align-items: flex-start; border: 2px solid var(--c-black); border-radius: var(--r-lg); padding: 22px 24px; background: #fff; }
  .cp-step-n { font-family: var(--font-mono); font-weight: 700; font-size: 1.5rem; color: var(--c-violet); flex: 0 0 auto; min-width: 2.4ch; }
  .cp-steps h3 { margin: 0 0 .35rem; font-size: 1.2rem; }
