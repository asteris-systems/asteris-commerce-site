---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import OrionStrip from '../components/OrionStrip.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Asteris Commerce. Australian WordPress + WooCommerce + Cart plugin suite. Sydney-built. One vendor. Three plugins: Asteris for WooCommerce, Asteris Utility Suite, and Asteris Cart.',
  ogImage = '/og-default.png',
  noindex = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}

  <!-- time-localise: renders <time datetime="…Z"> in viewer's browser timezone
       (per feedback_local_time_rule.md). Deferred — runs after DOM ready. -->
  <script src="/time-localise.js" defer></script>

  <!-- Asteris Partners — click tracker. Captures ?ref=<partner_public_id>,
       stores in localStorage, POSTs to pay.asteriscommerce.com/wp-json/asteris/v1/partners/track,
       and rewrites Stripe Checkout links to carry the partner ref through. -->
  <script src="/partners-tracker.js" defer></script>

  <title>{title}</title>

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
  <meta property="og:site_name" content="Asteris Commerce" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <slot name="head" />

  <!-- Google Analytics 4 (G-TXZL5GDQRT) — CONSENT-GATED.
       GA only loads after the visitor clicks "Accept" in the cookie banner
       (or on a return visit if they previously accepted). Declining loads nothing. -->
  <script is:inline>
    (function () {
      var GA_ID = 'G-TXZL5GDQRT';
      var loaded = false;
      function loadGA() {
        if (loaded) return;
        loaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag(){ window.dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', GA_ID, { anonymize_ip: true });
      }
      var consent = null;
      try { consent = localStorage.getItem('asteris-consent'); } catch (e) {}
      if (consent === 'accepted') {
        loadGA();
      } else {
        window.addEventListener('asteris:consent', function (e) {
          if (e && e.detail && e.detail.value === 'accepted') loadGA();
        });
      }
    })();
  </script>
</head>
<body>
  <Nav currentPath={currentPath} />
  <main>
    <slot />
  </main>
  <OrionStrip />
  <Footer />
  <CookieBanner />
</body>
</html>
